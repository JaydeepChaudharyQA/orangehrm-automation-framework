<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- Run with: mvnw test -Dsuite=smoke -->
<suite name="OrangeHRM Smoke Suite" parallel="classes" thread-count="2" verbose="1">
    <listeners>
        <listener class-name="io.github.jaydeepchaudharyqa.orangehrm.listeners.TestListener"/>
        <listener class-name="io.github.jaydeepchaudharyqa.orangehrm.listeners.RetryTransformer"/>
    </listeners>
    <test name="Smoke tests">
        <groups>
            <run>
                <include name="smoke"/>
            </run>
        </groups>
        <packages>
            <package name="io.github.jaydeepchaudharyqa.orangehrm.tests.*"/>
        </packages>
    </test>
</suite>
